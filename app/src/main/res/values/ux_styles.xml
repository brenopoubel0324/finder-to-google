<resources>
  <style name="UiTitle" parent="TextAppearance.Material3.HeadlineMedium">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:textColor">?attr/colorOnSurface</item>
    <item name="android:accessibilityHeading">true</item>
  </style>
  <style name="UiBody" parent="TextAppearance.Material3.BodyLarge">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:layout_marginTop">8dp</item>
    <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
  </style>
  <style name="UiCaption" parent="TextAppearance.Material3.LabelLarge">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:layout_marginTop">8dp</item>
    <item name="android:textColor">?attr/colorPrimary</item>
  </style>
  <style name="UiPrimary" parent="Widget.Material3.Button">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:layout_marginTop">16dp</item>
    <item name="android:minHeight">56dp</item>
    <item name="android:textSize">16sp</item>
    <item name="android:textAllCaps">false</item>
    <item name="android:singleLine">false</item>
  </style>
  <style name="UiSecondary" parent="Widget.Material3.Button.OutlinedButton">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:layout_marginTop">8dp</item>
    <item name="android:minHeight">52dp</item>
    <item name="android:textSize">16sp</item>
    <item name="android:textAllCaps">false</item>
    <item name="android:singleLine">false</item>
  </style>
  <style name="UiTextButton" parent="Widget.Material3.Button.TextButton">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:minHeight">48dp</item>
    <item name="android:textSize">16sp</item>
    <item name="android:textAllCaps">false</item>
    <item name="android:singleLine">false</item>
  </style>
</resources>
