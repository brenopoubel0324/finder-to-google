<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:clipToPadding="false">
    <br.com.findertogoogle.ui.MaxWidthLinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal" android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/app_name" android:textAppearance="?attr/textAppearanceHeadlineMedium" android:accessibilityHeading="true" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:text="@string/subtitle" android:textAppearance="?attr/textAppearanceBodyLarge" />
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" app:cardCornerRadius="20dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceTitleMedium" android:accessibilityLiveRegion="polite" />
                <TextView android:id="@+id/readiness" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:textAppearance="?attr/textAppearanceBodyMedium" />
                <TextView android:id="@+id/mode_status" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:textAppearance="?attr/textAppearanceLabelLarge" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" app:cardCornerRadius="20dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/browser_step"
                    android:textAppearance="?attr/textAppearanceTitleMedium" android:accessibilityHeading="true" />
                <TextView android:id="@+id/selected_browser" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:textAppearance="?attr/textAppearanceBodyMedium" />
                <com.google.android.material.button.MaterialButton android:maxLines="3" android:singleLine="false" android:id="@+id/choose_browser" style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/choose_browser" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
                    android:text="@string/mode_step" android:textAppearance="?attr/textAppearanceTitleMedium" android:accessibilityHeading="true" />
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/experimental"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/experimental_title" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/compatibility_summary"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
                    android:text="@string/activation_step" android:textAppearance="?attr/textAppearanceTitleMedium" android:accessibilityHeading="true" />
                <com.google.android.material.button.MaterialButton android:maxLines="3" android:singleLine="false" android:id="@+id/activate" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/activate" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" app:cardCornerRadius="20dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/tests_title"
                    android:textAppearance="?attr/textAppearanceTitleMedium" android:accessibilityHeading="true" />
                <com.google.android.material.button.MaterialButton android:maxLines="3" android:singleLine="false" android:id="@+id/test_search" style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/test_search" />
                <com.google.android.material.button.MaterialButton android:maxLines="3" android:singleLine="false" android:id="@+id/test_link" style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/test_link" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    android:text="@string/test_search_description" android:textAppearance="?attr/textAppearanceBodyMedium" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.button.MaterialButton android:maxLines="3" android:singleLine="false" android:id="@+id/advanced_toggle" style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/advanced_show" />
        <LinearLayout android:id="@+id/advanced_content" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/origin_warning"
                android:textAppearance="?attr/textAppearanceBodyMedium" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:text="@string/experimental_description" android:textAppearance="?attr/textAppearanceBodySmall" />
            <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/diagnostics" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginTop="16dp" android:text="@string/diagnostics_title" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/diagnostics_description"
                android:textAppearance="?attr/textAppearanceBodyMedium" />
            <TextView android:id="@+id/diagnostic_report" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:textAppearance="?attr/textAppearanceBodyMedium" android:textIsSelectable="true" />
            <com.google.android.material.button.MaterialButton android:maxLines="3" android:singleLine="false" android:id="@+id/copy_diagnostics" style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/copy_diagnostics" />
            <com.google.android.material.button.MaterialButton android:maxLines="3" android:singleLine="false" android:id="@+id/clear_diagnostics" style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/clear_diagnostics" />
            <com.google.android.material.button.MaterialButton android:maxLines="3" android:singleLine="false" android:id="@+id/restore" style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/restore" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:text="@string/privacy_note" android:textAppearance="?attr/textAppearanceBodySmall" />
        <TextView android:id="@+id/version" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:textAppearance="?attr/textAppearanceBodySmall" />
    </br.com.findertogoogle.ui.MaxWidthLinearLayout>
</ScrollView>
