<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:clipToPadding="false">
    <br.com.findertogoogle.ui.MaxWidthLinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal" android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/calibration_confirm_title" android:textAppearance="?attr/textAppearanceHeadlineMedium" android:accessibilityHeading="true" />
        <TextView android:id="@+id/calibration_message" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/calibration_confirm_message" android:textAppearance="?attr/textAppearanceBodyLarge" android:accessibilityLiveRegion="polite" />
        <TextView android:id="@+id/calibration_client" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:textIsSelectable="true" android:textAppearance="?attr/textAppearanceBodyLarge" />
        <com.google.android.material.button.MaterialButton android:id="@+id/confirm_signature"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp"
            android:maxLines="3" android:singleLine="false" android:text="@string/calibration_confirm_save" />
        <com.google.android.material.button.MaterialButton android:id="@+id/skip_signature" style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="3" android:singleLine="false" android:text="@string/calibration_skip" />
    </br.com.findertogoogle.ui.MaxWidthLinearLayout>
</ScrollView>
